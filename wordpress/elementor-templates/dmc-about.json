      {
       "id": "1f610dc",
       "elType": "widget",
       "widgetType": "html",
       "settings": {
        "html": "<section class=\"dmc-section\" style=\"padding-top: 0\">\n        <div class=\"dmc-wrap\">\n          <div class=\"dmc-head\">\n            <div>\n              <div class=\"dmc-eyebrow\">Our expertise</div>\n              <h2 class=\"dmc-h2\" data-split>Built on <em class=\"dmc-accent\">four</em> strengths</h2>\n            </div>\n            <p class=\"dmc-lead\">From international sourcing to the last mile, every step is handled in-house so the almonds you receive are exactly the grade you ordered.</p>\n          </div>\n          <div class=\"dmc-why__grid\" data-stagger>\n            <div class=\"dmc-value\">\n              <div class=\"dmc-feature__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\" /><path d=\"M3 12h18M12 3a14 14 0 010 18M12 3a14 14 0 000 18\" /></svg></div>\n              <h3>Dry fruit import &amp; trade</h3>\n              <p>Direct sourcing from international markets including the USA, Australia, and the Middle East.</p>\n            </div>\n            <div class=\"dmc-value\">\n              <div class=\"dmc-feature__icon\" style=\"background: linear-gradient(145deg, #5aa83a, var(--dmc-green-700))\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 6h16M7 12h10M10 18h4\" /></svg></div>\n              <h3>Processing &amp; quality control</h3>\n              <p>Advanced sorting, grading, and hygienic packaging to deliver top-quality products.</p>\n            </div>\n            <div class=\"dmc-value\">\n              <div class=\"dmc-feature__icon\" style=\"background: linear-gradient(145deg, #f3e6cc, #d9bf8e); color: var(--dmc-brown)\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 17l6-6 4 4 8-8\" /><path d=\"M14 7h7v7\" /></svg></div>\n              <h3>Market expansion</h3>\n              <p>A strong domestic presence complemented by growing international trade relations.</p>\n            </div>\n            <div class=\"dmc-value\">\n              <div class=\"dmc-feature__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 7h11v9H3zM14 10h4l3 3v3h-7z\" /><circle cx=\"7\" cy=\"18\" r=\"1.6\" /><circle cx=\"17\" cy=\"18\" r=\"1.6\" /></svg></div>\n              <h3>Supply chain management</h3>\n              <p>Efficient procurement, storage, and logistics for seamless distribution.</p>\n            </div>\n          </div>\n        </div>\n      </section>"
       },
       "elements": []
      }
     ]
    }
   ]
