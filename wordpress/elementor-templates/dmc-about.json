      {
       "id": "c6a6f45",
       "elType": "widget",
       "widgetType": "html",
       "settings": {
        "html": "<section class=\"dmc-section\">\n        <div class=\"dmc-wrap dmc-split\">\n          <div class=\"dmc-collage\">\n            <div data-img-reveal><img src=\"/wp-content/plugins/dmc-revamp/assets/img/almond-bowl.jpg\" alt=\"Premium almonds in a bowl\" loading=\"lazy\" /></div>\n            <div data-img-reveal style=\"background: #fff; display: grid; place-items: center\"><img src=\"/wp-content/plugins/dmc-revamp/assets/img/products/orange-bag.jpg\" alt=\"DMC Nuts Orange Bag\" style=\"object-fit: contain; padding: 14px\" loading=\"lazy\" /></div>\n            <div data-img-reveal style=\"background: #fff; display: grid; place-items: center\"><img src=\"/wp-content/plugins/dmc-revamp/assets/img/products/purple-bag.jpg\" alt=\"DMC Nuts Purple Bag\" style=\"object-fit: contain; padding: 14px\" loading=\"lazy\" /></div>\n          </div>\n          <div>\n            <div class=\"dmc-eyebrow\">Who we are</div>\n            <h2 class=\"dmc-h2\" data-split>A trusted name in <em class=\"dmc-accent\">dry fruit</em> &amp; agro-commodity trade</h2>\n            <p class=\"dmc-lead\" style=\"margin-top: 22px\" data-reveal>Deepak Mange &amp; Co. is a well-established food processing and trading firm specializing in the import, processing, and distribution of premium edible nuts, with a strong focus on almonds.</p>\n            <p style=\"margin-top: 16px; color: var(--dmc-brown-700)\" data-reveal>Since our incorporation in 2018, we have earned a reputation for sourcing the finest dry fruits, maintaining strict quality standards, and ensuring efficient distribution across India and beyond. With our strategic presence in Navi Mumbai’s APMC Market, our success is driven by our commitment to quality, innovation, and customer satisfaction.</p>\n            <div style=\"margin-top: 34px; display: flex; gap: 12px; flex-wrap: wrap\">\n              <a class=\"dmc-btn\" href=\"/shop/\" data-magnetic>Explore Varieties <svg class=\"dmc-arrow\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\" /></svg></a>\n              <a class=\"dmc-btn dmc-btn--ghost\" href=\"/#quote\" data-magnetic>Bulk Enquiry</a>\n            </div>\n          </div>\n        </div>\n      </section>"
       },
       "elements": []
      }
     ]
    }
   ]
  },
