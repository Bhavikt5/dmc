      {
       "id": "f011c56",
       "elType": "widget",
       "widgetType": "html",
       "settings": {
        "html": "<section class=\"dmc-page-hero dmc-page-hero--dark dmc-bg-dark\">\n        <div data-dmc-particles aria-hidden=\"true\"></div>\n        <div class=\"dmc-wrap\">\n          <nav class=\"dmc-crumbs\" aria-label=\"Breadcrumb\"><a href=\"/\">Home</a><span aria-hidden=\"true\">/</span><span>About Us</span></nav>\n          <div class=\"dmc-about-hero__grid\">\n            <div>\n              <div class=\"dmc-eyebrow\" data-reveal=\"fade\">Deepak Mange &amp; Co.</div>\n              <h1 class=\"dmc-h1\" data-split>From the finest orchards to <em class=\"dmc-accent\" style=\"color: #9bd27d\">your shelves</em></h1>\n            </div>\n            <p class=\"dmc-lead\" data-reveal>Experience purity, freshness, and reliability with every almond. Since 2018 we have imported, processed and distributed premium edible nuts across India and beyond.</p>\n          </div>\n          <div class=\"dmc-stats\" style=\"margin-top: clamp(48px, 7vw, 96px)\">\n            <div class=\"dmc-stat\"><strong>2018</strong><span>Incorporated</span></div>\n            <div class=\"dmc-stat\"><strong data-countup=\"3\">3</strong><span>Sourcing regions — USA, Australia, Middle East</span></div>\n            <div class=\"dmc-stat\"><strong data-countup=\"9\">9</strong><span>Graded almond varieties</span></div>\n            <div class=\"dmc-stat\"><strong>APMC</strong><span>Navi Mumbai base</span></div>\n          </div>\n        </div>\n      </section>"
       },
       "elements": []
      }
     ]
    }
   ]
  },
