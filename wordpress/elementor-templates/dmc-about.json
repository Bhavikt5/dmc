       "id": "46bf28c",
       "elType": "widget",
       "widgetType": "html",
       "settings": {
        "html": "<section class=\"dmc-bg-dark dmc-hscroll\" style=\"padding: clamp(64px, 9vw, 120px) 0\">\n        <div class=\"dmc-hscroll__track\">\n          <div class=\"dmc-step dmc-step--intro\">\n            <div class=\"dmc-eyebrow\">How we work</div>\n            <h2 class=\"dmc-h2\">Orchard to <em class=\"dmc-accent\" style=\"color: #9bd27d\">doorstep</em></h2>\n            <p class=\"dmc-lead\" style=\"margin-top: 18px\">Scroll through the four stages every DMC bag goes through.</p>\n          </div>\n          <div class=\"dmc-step\">\n            <span class=\"dmc-step__num\">01</span>\n            <h3>Source</h3>\n            <p>Almonds are bought directly from trusted growers and exporters in the USA, Australia and the Middle East.</p>\n          </div>\n          <div class=\"dmc-step\">\n            <span class=\"dmc-step__num\">02</span>\n            <h3>Sort &amp; grade</h3>\n            <p>Every lot is sorted and graded by grain and count, then assigned to its colour-coded bag.</p>\n          </div>\n          <div class=\"dmc-step dmc-step--accent\">\n            <span class=\"dmc-step__num\">03</span>\n            <h3>Pack hygienically</h3>\n            <p>Sanitized units and hands-free technology keep the almonds clean, crisp and sealed for freshness.</p>\n          </div>\n          <div class=\"dmc-step\">\n            <span class=\"dmc-step__num\">04</span>\n            <h3>Distribute</h3>\n            <p>Efficient storage and logistics from the APMC Market deliver bulk orders across India and abroad.</p>\n          </div>\n        </div>\n      </section>"
       },
       "elements": []
      }
     ]
    }
   ]
  },
