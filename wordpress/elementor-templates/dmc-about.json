       "id": "15e72cb",
       "elType": "widget",
       "widgetType": "html",
       "settings": {
        "html": "<section class=\"dmc-section dmc-bg-cream2\">\n        <div class=\"dmc-wrap dmc-founder\">\n          <div class=\"dmc-founder__card\" data-reveal=\"scale\">\n            <img src=\"/wp-content/plugins/dmc-revamp/assets/img/logo.webp\" alt=\"\" loading=\"lazy\" />\n            <strong>Deepak Arjan Mange</strong>\n            <span>Founder</span>\n          </div>\n          <div>\n            <div class=\"dmc-eyebrow\">Leadership</div>\n            <blockquote data-reveal>A seasoned entrepreneur with deep expertise in the global dry fruit trade.</blockquote>\n            <p style=\"margin-top: 22px; color: var(--dmc-brown-700); max-width: 640px\" data-reveal>Deepak Arjan Mange, the founder of Deepak Mange &amp; Co., brings a strong network of suppliers and distributors, combined with a vision for growth and sustainability, that drives the company forward as a leading player in India’s dry fruit industry.</p>\n          </div>\n        </div>\n      </section>"
