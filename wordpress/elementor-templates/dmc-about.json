     "elements": [
      {
       "id": "dfe9199",
       "elType": "widget",
       "widgetType": "html",
       "settings": {
        "html": "<section class=\"dmc-section\">\n        <div class=\"dmc-wrap dmc-split dmc-split--rev\">\n          <div class=\"dmc-media dmc-media--wide\" data-img-reveal>\n            <img src=\"/wp-content/plugins/dmc-revamp/assets/img/almond-bowl.jpg\" alt=\"Almonds in a wooden spoon and bowl\" style=\"object-position: 15% 50%\" data-parallax=\"0.08\" loading=\"lazy\" />\n          </div>\n          <div>\n            <div class=\"dmc-eyebrow\">Quality commitment</div>\n            <h2 class=\"dmc-h2\" data-split>Quality at the <em class=\"dmc-accent\">core</em> of everything</h2>\n            <p class=\"dmc-lead\" style=\"margin-top: 22px\" data-reveal>At Deepak Mange &amp; Co., we place quality at the core of everything we do. Our processes are built on:</p>\n            <ul class=\"dmc-checks\" data-stagger>\n              <li><span><strong>FSSAI Certification</strong> ensuring compliance with India’s food safety and hygiene standards.</span></li>\n              <li><span><strong>Hygienic Processing Practices</strong> through sanitized units and hands-free technology.</span></li>\n              <li><span><strong>Regular Quality Testing</strong> to guarantee that every product meets stringent industry benchmarks.</span></li>\n            </ul>\n            <div class=\"dmc-certs\" style=\"justify-content: flex-start; gap: 12px\">\n              <div class=\"dmc-cert\" style=\"padding-right: 20px\"><img src=\"https://dmcnuts.com/wp-content/uploads/2025/09/iso.jpg\" alt=\"ISO\" loading=\"lazy\" style=\"width: 48px; height: 48px\" /><strong>ISO</strong></div>\n              <div class=\"dmc-cert\" style=\"padding-right: 20px\"><img src=\"https://dmcnuts.com/wp-content/uploads/2025/09/gmp.jpg\" alt=\"GMP\" loading=\"lazy\" style=\"width: 48px; height: 48px\" /><strong>GMP</strong></div>\n              <div class=\"dmc-cert\" style=\"padding-right: 20px\"><img src=\"https://dmcnuts.com/wp-content/uploads/2025/09/fssi.jpg\" alt=\"FSSAI\" loading=\"lazy\" style=\"width: 48px; height: 48px\" /><strong>FSSAI</strong></div>\n            </div>\n          </div>\n        </div>\n      </section>"
       },
       "elements": []
      }
     ]
    }
   ]
