      {
       "id": "1b92184",
       "elType": "widget",
       "widgetType": "html",
       "settings": {
        "html": "<section class=\"dmc-section\">\n        <div class=\"dmc-wrap\">\n          <div class=\"dmc-head\">\n            <div>\n              <div class=\"dmc-eyebrow\">Our vision</div>\n              <h2 class=\"dmc-h2\" data-split>Growing with <em class=\"dmc-accent\">purpose</em></h2>\n            </div>\n            <p class=\"dmc-lead\">We are continuously working to expand and diversify our operations to meet evolving consumer needs. Our future goals include:</p>\n          </div>\n          <div class=\"dmc-vision\" data-stagger>\n            <div><b>01</b><h3>Modern automation</h3><p>Expanding processing facilities with modern automation.</p></div>\n            <div><b>02</b><h3>Value-added range</h3><p>Launching value-added dry fruit products for the retail and wholesale markets.</p></div>\n            <div><b>03</b><h3>Digital trade</h3><p>Strengthening e-commerce and digital trade channels.</p></div>\n            <div><b>04</b><h3>Sustainability</h3><p>Investing in eco-friendly and sustainable processing practices.</p></div>\n          </div>\n        </div>\n      </section>"
       },
