       "elType": "widget",
       "widgetType": "html",
       "settings": {
        "html": "<section class=\"dmc-section\" style=\"padding-top: 0\">\n        <div class=\"dmc-wrap\">\n          <div class=\"dmc-cta\" data-reveal=\"scale\">\n            <div>\n              <div class=\"dmc-eyebrow\" style=\"color: #b8e39c\">Reach us anytime</div>\n              <h2 class=\"dmc-h2\" data-split>Let's talk about your next bulk order</h2>\n              <p>Visit us at L-41, Phase-2, APMC Market, Turbhe, Vashi, Navi Mumbai — or message us for today's rates.</p>\n            </div>\n            <div style=\"display: flex; flex-direction: column; gap: 12px\">\n              <a class=\"dmc-btn dmc-btn--light dmc-btn--block\" href=\"https://wa.me/917977635556\" target=\"_blank\" rel=\"noopener\" data-magnetic>WhatsApp +91 79776 35556</a>\n              <a class=\"dmc-btn dmc-btn--almond dmc-btn--block\" href=\"mailto:deepakmangeandco@gmail.com\" data-magnetic>deepakmangeandco@gmail.com</a>\n              <a class=\"dmc-btn dmc-btn--ghost dmc-btn--block\" style=\"--fg: #fff; box-shadow: inset 0 0 0 1.5px rgba(255,255,255,.5)\" href=\"https://maps.app.goo.gl/W9XjvdCmkQWjnR6T6\" target=\"_blank\" rel=\"noopener\">Get directions</a>\n            </div>\n          </div>\n        </div>\n      </section>"
