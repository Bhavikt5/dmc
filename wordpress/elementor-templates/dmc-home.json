       "elType": "widget",
       "widgetType": "html",
       "settings": {
        "html": "<div class=\"dmc-ticker dmc-marquee\" aria-label=\"Why buy from us\">\n        <div class=\"dmc-marquee__track\" data-speed=\"34\">\n          <span class=\"dmc-pill dmc-pill--1\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 7h11v9H3zM14 10h4l3 3v3h-7z\" /><circle cx=\"7\" cy=\"18\" r=\"1.6\" /><circle cx=\"17\" cy=\"18\" r=\"1.6\" /></svg>Free Shipping · For Bulk Buy</span>\n          <span class=\"dmc-pill dmc-pill--2\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z\" /><path d=\"M9 12l2 2 4-4\" /></svg>FSSAI Licensed</span>\n          <span class=\"dmc-pill dmc-pill--3\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 12a8 8 0 11-3-6.2\" /><path d=\"M20 4v5h-5\" /></svg>Easy Returns</span>\n          <span class=\"dmc-pill dmc-pill--4\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6\" /></svg>Huge Savings · Lowest Price</span>\n          <span class=\"dmc-pill dmc-pill--1\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\" /><path d=\"M3 12h18M12 3a14 14 0 010 18M12 3a14 14 0 000 18\" /></svg>Direct Import · USA, Australia, Middle East</span>\n          <span class=\"dmc-pill dmc-pill--2\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 6h16M7 12h10M10 18h4\" /></svg>Sorted &amp; Graded</span>\n          <span class=\"dmc-pill dmc-pill--3\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 11V7a5 5 0 0110 0v4\" /><rect x=\"4\" y=\"11\" width=\"16\" height=\"10\" rx=\"2\" /></svg>Hygienic, Hands-free Packing</span>\n        </div>\n      </div>"
