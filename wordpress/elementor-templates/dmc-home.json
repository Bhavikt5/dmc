       "id": "15b7ddd",
       "elType": "widget",
       "widgetType": "html",
       "settings": {
        "html": "<section class=\"dmc-section\" id=\"quote\" style=\"padding-top: 0\">\n        <div class=\"dmc-wrap\">\n          <div class=\"dmc-cta\" data-reveal=\"scale\">\n            <div>\n              <div class=\"dmc-eyebrow\" style=\"color: #b8e39c\">Bulk purchase request</div>\n              <h2 class=\"dmc-h2\" data-split>Get today's wholesale rate in minutes</h2>\n              <p>Tell us the grade and quantity you need. Our team replies on WhatsApp with current pricing and dispatch timelines.</p>\n            </div>\n            <form class=\"dmc-qform\" data-wa-form>\n              <input name=\"Name\" placeholder=\"Full name *\" required autocomplete=\"name\" />\n              <input name=\"Mobile\" placeholder=\"Mobile number *\" required inputmode=\"tel\" autocomplete=\"tel\" />\n              <input class=\"full\" name=\"Company\" placeholder=\"Company name\" autocomplete=\"organization\" />\n              <select name=\"Interested in\" required>\n                <option value=\"\">Interested in *</option>\n                <option>Orange Bag</option>\n                <option>White Bag (American 3D)</option>\n                <option>Yellow Bag</option>\n                <option>Pink Bag</option>\n                <option>Purple Bag</option>\n                <option>Blue Bag</option>\n                <option>Golden Bag</option>\n                <option>Independent Bag</option>\n                <option>Independent 3D</option>\n                <option>Touch</option>\n                <option>Super Touch</option>\n              </select>\n              <input name=\"Minimum quantity\" placeholder=\"Quantity (bags)\" inputmode=\"numeric\" />\n              <button class=\"dmc-btn dmc-btn--light full\" type=\"submit\">Send enquiry on WhatsApp <svg class=\"dmc-arrow\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\" /></svg></button>\n              <small>Opens WhatsApp with your details pre-filled. Nothing is stored on this site.</small>\n            </form>\n          </div>\n        </div>\n      </section>"
