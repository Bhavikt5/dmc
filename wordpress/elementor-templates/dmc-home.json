        "html": "<section class=\"dmc-section\">\n        <div class=\"dmc-wrap\">\n          <div class=\"dmc-head dmc-head--center\">\n            <div class=\"dmc-eyebrow dmc-eyebrow--center\">The DMC difference</div>\n            <h2 class=\"dmc-h2\" data-split>Why buyers <em class=\"dmc-accent\">switch</em> to DMC</h2>\n          </div>\n          <div class=\"dmc-compare\" data-reveal=\"scale\">\n            <table>\n              <thead>\n                <tr><th>What you get</th><th>Loose market stock</th><th class=\"us\">DMC Nuts</th></tr>\n              </thead>\n              <tbody>\n                <tr><td>Graded by grain &amp; count</td><td><span class=\"dmc-no\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\"><path d=\"M6 6l12 12M18 6L6 18\" /></svg></span></td><td class=\"us\"><span class=\"dmc-yes\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12.5l4.5 4.5L19 7\" /></svg></span></td></tr>\n                <tr><td>Direct import sourcing</td><td><span class=\"dmc-no\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\"><path d=\"M6 6l12 12M18 6L6 18\" /></svg></span></td><td class=\"us\"><span class=\"dmc-yes\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12.5l4.5 4.5L19 7\" /></svg></span></td></tr>\n                <tr><td>Hygienic, hands-free packing</td><td><span class=\"dmc-no\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\"><path d=\"M6 6l12 12M18 6L6 18\" /></svg></span></td><td class=\"us\"><span class=\"dmc-yes\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12.5l4.5 4.5L19 7\" /></svg></span></td></tr>\n                <tr><td>Colour-coded bags for easy inventory</td><td><span class=\"dmc-no\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\"><path d=\"M6 6l12 12M18 6L6 18\" /></svg></span></td><td class=\"us\"><span class=\"dmc-yes\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12.5l4.5 4.5L19 7\" /></svg></span></td></tr>\n                <tr><td>Free shipping on bulk orders</td><td><span class=\"dmc-no\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\"><path d=\"M6 6l12 12M18 6L6 18\" /></svg></span></td><td class=\"us\"><span class=\"dmc-yes\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12.5l4.5 4.5L19 7\" /></svg></span></td></tr>\n              </tbody>\n            </table>\n          </div>\n        </div>\n      </section>"
