      {
       "id": "39cfdde",
       "elType": "widget",
       "widgetType": "html",
       "settings": {
        "html": "<section class=\"dmc-section dmc-bg-white\">\n        <div class=\"dmc-wrap dmc-split\">\n          <div class=\"dmc-media\" data-img-reveal>\n            <img src=\"/wp-content/plugins/dmc-revamp/assets/img/almond-bowl.jpg\" alt=\"A bowl of premium almonds on a wooden table\" data-parallax=\"0.08\" loading=\"lazy\" />\n            <div class=\"dmc-media__float\" data-reveal=\"up\">\n              <strong>100%</strong>\n              <span>Sun-dried &amp;<br />packed fresh</span>\n            </div>\n          </div>\n          <div>\n            <div class=\"dmc-eyebrow\">Farm fresh almond</div>\n            <h2 class=\"dmc-h2\" data-split>Handpicked for <em class=\"dmc-accent\">premium</em> quality</h2>\n            <p class=\"dmc-lead\" style=\"margin-top: 22px\" data-reveal>Sourced from the finest farms, our almonds are carefully handpicked to ensure premium quality. Rich in protein, fiber, and essential nutrients, they make the perfect choice for a healthy lifestyle.</p>\n            <ul class=\"dmc-checks\" data-stagger>\n              <li>Each almond is naturally sun-dried, preserving its authentic taste and crunch.</li>\n              <li>Packed fresh to seal in flavor and goodness for longer shelf life.</li>\n              <li>The perfect blend of health, taste, and energy in every bite.</li>\n            </ul>\n            <a class=\"dmc-btn\" href=\"/shop/\" data-magnetic>Shop Now <svg class=\"dmc-arrow\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\" /></svg></a>\n          </div>\n        </div>\n      </section>"
       },
       "elements": []
      }
     ]
    }
   ]
