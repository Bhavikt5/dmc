     "elements": [
      {
       "id": "b3d6d04",
       "elType": "widget",
       "widgetType": "html",
       "settings": {
        "html": "<section class=\"dmc-section dmc-bg-dark dmc-why\">\n        <div class=\"dmc-wrap\">\n          <div class=\"dmc-head\">\n            <div>\n              <div class=\"dmc-eyebrow\">Why choose DMC almonds?</div>\n              <h2 class=\"dmc-h2\" data-split>Wholesale excellence for <em class=\"dmc-accent\" style=\"color: #9bd27d\">global</em> markets</h2>\n            </div>\n            <p class=\"dmc-lead\">At DMC, we bring you premium quality almonds sourced directly from trusted farms. Known for their rich taste, superior crunch, and natural freshness, our almonds are supplied in bulk to businesses across India and global markets.</p>\n          </div>\n          <div class=\"dmc-why__grid\" data-stagger>\n            <div class=\"dmc-feature\">\n              <span class=\"dmc-feature__num\">01</span>\n              <div class=\"dmc-feature__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\" /><path d=\"M3 12h18M12 3a14 14 0 010 18M12 3a14 14 0 000 18\" /></svg></div>\n              <h3>Direct import</h3>\n              <p>Direct sourcing from international markets including the USA, Australia, and the Middle East.</p>\n            </div>\n            <div class=\"dmc-feature\">\n              <span class=\"dmc-feature__num\">02</span>\n              <div class=\"dmc-feature__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 6h16M7 12h10M10 18h4\" /></svg></div>\n              <h3>Sorted &amp; graded</h3>\n              <p>Advanced sorting, grading, and hygienic packaging to deliver top-quality products.</p>\n            </div>\n            <div class=\"dmc-feature\">\n              <span class=\"dmc-feature__num\">03</span>\n              <div class=\"dmc-feature__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z\" /><path d=\"M9 12l2 2 4-4\" /></svg></div>\n              <h3>Food-safe processing</h3>\n              <p>FSSAI-compliant units with sanitized, hands-free processing and regular quality testing.</p>\n            </div>\n            <div class=\"dmc-feature\">\n              <span class=\"dmc-feature__num\">04</span>\n              <div class=\"dmc-feature__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 7h11v9H3zM14 10h4l3 3v3h-7z\" /><circle cx=\"7\" cy=\"18\" r=\"1.6\" /><circle cx=\"17\" cy=\"18\" r=\"1.6\" /></svg></div>\n              <h3>Seamless supply</h3>\n              <p>Efficient procurement, storage, and logistics from Navi Mumbai's APMC Market.</p>\n            </div>\n          </div>\n          <div class=\"dmc-stats\" style=\"margin-top: clamp(48px, 6vw, 80px)\">\n            <div class=\"dmc-stat\"><strong>2018</strong><span>Incorporated</span></div>\n            <div class=\"dmc-stat\"><strong data-countup=\"9\">9</strong><span>Graded almond varieties</span></div>\n            <div class=\"dmc-stat\"><strong data-countup=\"3\">3</strong><span>Sourcing regions</span></div>\n            <div class=\"dmc-stat\"><strong><span data-countup=\"30\" style=\"display: inline; margin: 0; font-size: inherit; color: inherit\">30</span> Kg</strong><span>Largest bag size</span></div>\n          </div>\n        </div>\n      </section>"
       },
       "elements": []
      }
     ]
    }
   ]
